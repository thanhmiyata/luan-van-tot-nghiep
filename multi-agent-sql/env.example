# Multi-Agent SQL System - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# ============================================
# AI Model API Keys
# ============================================

# Google Gemini API Key (Required)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# OpenAI API Key (Optional)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek API Key (Optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================
# Model Configuration
# ============================================

# Default AI model to use
# Options: gemini-2.0-flash, gemini-1.5-pro, gpt-4, gpt-3.5-turbo, etc.
DEFAULT_MODEL=gemini-2.0-flash

# Temperature for AI responses (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.0

# Maximum tokens for AI responses
MAX_TOKENS=2048

# API request timeout (seconds)
TIMEOUT=30

# ============================================
# Logging Configuration
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (relative to project root)
LOG_FILE=logs/multi_agent_sql.log

# ============================================
# Benchmark Configuration
# ============================================

# Default number of questions to test
DEFAULT_QUESTIONS_COUNT=50

# Number of benchmark runs for averaging results
DEFAULT_RUNS=3

# Results output directory
RESULTS_DIR=data/results

# ============================================
# Database Configuration
# ============================================

# Database directory (SQLite files)
DATABASE_DIR=data/schemas/database

# Tables schema file path
TABLES_FILE=data/schemas/tables.json

# ============================================
# Test Suite Configuration
# ============================================

# Path to test-suite-sql-eval directory
TEST_SUITE_DIR=test-suite-sql-eval

# Evaluation timeout (seconds)
EVALUATION_TIMEOUT=300

# ============================================
# Advanced Settings (Optional)
# ============================================

# Enable debug mode
DEBUG=False

# Enable verbose output
VERBOSE=True

# Cache API responses (for development)
CACHE_RESPONSES=False

# Max retries for API calls
MAX_RETRIES=3

# Retry delay (seconds)
RETRY_DELAY=1

