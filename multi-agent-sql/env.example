# Multi-Agent SQL Environment Configuration

# Google/Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# OpenAI API Configuration (optional, for comparison)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
DEFAULT_MODEL=gemini-2.0-flash
TEMPERATURE=0.0
MAX_TOKENS=2048
TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/multi_agent_sql.log

# Benchmark Configuration
DEFAULT_QUESTIONS_COUNT=50
DEFAULT_RUNS=3
RESULTS_DIR=data/results

# Database Configuration
DATABASE_DIR=data/schemas/database
TABLES_FILE=data/schemas/tables.json

# Test Suite Configuration
TEST_SUITE_DIR=test-suite-sql-eval
EVALUATION_TIMEOUT=300
