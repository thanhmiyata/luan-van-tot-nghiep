    "sql_query": "SELECT DATE_TRUNC('month', p.payment_date) as month, SUM(p.amount) \n            FROM payment p \n            WHERE EXTRACT(year FROM p.payment_date) = 2005 \n            GROUP BY month \n            ORDER BY month;",
