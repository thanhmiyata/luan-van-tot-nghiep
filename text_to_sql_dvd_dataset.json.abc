  {
    "question_id": "Q0301",
    "level": 2,
    "language": "vi",
    "domain": "basic_business",
    "question": "Hiển thị 5 khách hàng thuê phim nhiều nhất",
    "sql_query": "SELECT c.first_name, c.last_name, COUNT(r.rental_id) \n            FROM customer c \n            JOIN rental r ON c.customer_id = r.customer_id \n            GROUP BY c.customer_id \n            ORDER BY COUNT(r.rental_id) DESC \n            LIMIT 5;",
    "explanation": "Liệt kê 5 khách hàng có số lượt thuê phim nhiều nhất",
    "expected_result_type": "table",
    "complexity_features": [
      "join_two_tables",
      "group_by",
      "basic_aggregate"
    ],
    "business_context": "basic_business"
  },
  {
    "question_id": "Q0302",
    "level": 2,
    "language": "en",
    "domain": "basic_business",
    "question": "Show top 5 customers by rental count",
    "sql_query": "SELECT c.first_name, c.last_name, COUNT(r.rental_id) \n            FROM customer c \n            JOIN rental r ON c.customer_id = r.customer_id \n            GROUP BY c.customer_id \n            ORDER BY COUNT(r.rental_id) DESC \n            LIMIT 5;",
    "explanation": "List top 5 customers with the most rental transactions",
    "expected_result_type": "table",
    "complexity_features": [
      "join_two_tables",
      "group_by",
      "basic_aggregate"
    ],
    "business_context": "basic_business"
  },
