  {
    "question_id": "Q0551",
    "level": 3,
    "language": "vi",
    "domain": "financial_analysis",
    "question": "Doanh thu theo từng tháng năm 2005",
    "sql_query": "SELECT DATE_TRUNC('month', p.payment_date) as month, SUM(p.amount) \n            FROM payment p \n            WHERE EXTRACT(year FROM p.payment_date) = 2005 \n            GROUP BY month \n            ORDER BY month;",
    "explanation": "Tính tổng doanh thu từng tháng trong năm 2005",
    "expected_result_type": "table",
    "complexity_features": [
      "join_multiple_tables",
      "subquery",
      "date_function"
    ],
    "business_context": "financial_analysis"
  },
  {
    "question_id": "Q0552",
    "level": 3,
    "language": "en",
    "domain": "financial_analysis",
    "question": "Monthly revenue for year 2005",
    "sql_query": "SELECT DATE_TRUNC('month', p.payment_date) as month, SUM(p.amount) \n            FROM payment p \n            WHERE EXTRACT(year FROM p.payment_date) = 2005 \n            GROUP BY month \n            ORDER BY month;",
    "explanation": "Calculate total monthly revenue in year 2005",
    "expected_result_type": "table",
    "complexity_features": [
      "join_multiple_tables",
      "subquery",
      "date_function"
    ],
    "business_context": "financial_analysis"
