  },
  {
    "question_id": "Q0973",
    "level": 5,
    "language": "vi",
    "domain": "customer_analytics",
    "question": "Phân tích giá trị trọn đời của khách hàng (LTV)",
    "sql_query": "WITH customer_payments AS (\n                SELECT customer_id, SUM(amount) AS total_spent \n                FROM payment \n                GROUP BY customer_id\n            )\n            SELECT c.first_name, c.last_name, cp.total_spent \n            FROM customer c \n            JOIN customer_payments cp ON c.customer_id = cp.customer_id \n            ORDER BY cp.total_spent DESC;",
    "explanation": "Tính tổng chi tiêu mỗi khách hàng để phân tích LTV",
    "expected_result_type": "table",
    "complexity_features": [
      "cte",
      "advanced_analytics",
      "recursive_query"
    ],
    "business_context": "customer_analytics"
  },
