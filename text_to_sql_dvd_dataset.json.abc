    "domain": "inventory_management",
    "question": "Liệt kê các bộ phim có thời lượng dài hơn mức trung bình của thể loại tương ứng",
    "sql_query": "SELECT f.title \n            FROM film f \n            JOIN film_category fc ON f.film_id = fc.film_id \n            JOIN category c ON fc.category_id = c.category_id \n            WHERE f.length > (\n                SELECT AVG(f2.length) \n                FROM film f2 \n                JOIN film_category fc2 ON f2.film_id = fc2.film_id \n                WHERE fc2.category_id = fc.category_id\n            );",
    "explanation": "Chọn các phim có thời lượng vượt mức trung bình của cùng thể loại",
    "expected_result_type": "table",
    "complexity_features": [
      "complex_subquery",
      "window_function",
      "exists_operator"
    ],
    "business_context": "inventory_management"
  },
