# Test environment configuration for Multi-Agent Text-to-SQL System

# LLM API Configuration (dummy keys for testing)
OPENAI_API_KEY=test_key
ANTHROPIC_API_KEY=test_key

# Database Configuration
DATABASE_URL=postgresql://$(whoami)@localhost:5432/text2sql_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=text2sql_db
DATABASE_USER=$(whoami)
DATABASE_PASSWORD=

# System Configuration
DEBUG=True
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Agent Configuration
MAX_RETRIES=3
TIMEOUT_SECONDS=30
ENABLE_CACHING=True

# Performance Configuration
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=60

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090 